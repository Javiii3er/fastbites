generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int              @id @default(autoincrement())
  name      String           @db.VarChar(100)
  email     String           @unique @db.VarChar(150)
  password  String           @db.VarChar(255)
  phone     String?          @db.VarChar(20)
  role      Role             @default(CLIENT)
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  addresses Address[]
  orders    Order[]
  payments  PaymentMethod_[]
  cartItems CartItem[] 

  @@map("users")
}

model Restaurant {
  id        Int                 @id @default(autoincrement())
  name      String              @db.VarChar(100)
  address   String              @db.VarChar(255)
  latitude  Decimal             @db.Decimal(10, 8)
  longitude Decimal             @db.Decimal(11, 8)
  phone     String?             @db.VarChar(20)
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  orders    Order[]
  products  Product[]
  dayParts  RestaurantDayPart[]

  @@map("restaurants")
}

model RestaurantDayPart {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  dayPart      DayPart
  startTime    String     @db.VarChar(5)
  endTime      String     @db.VarChar(5)
  isActive     Boolean    @default(true)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  @@unique([restaurantId, dayPart])
  @@map("restaurant_day_parts")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(80)
  dayPart   DayPart
  imageUrl  String?   @db.VarChar(500)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  products  Product[]

  @@map("categories")
}

model Product {
  id           Int           @id @default(autoincrement())
  restaurantId Int
  categoryId   Int
  name         String        @db.VarChar(100)
  description  String?       @db.Text
  basePrice    Decimal       @db.Decimal(10, 2)
  imageUrl     String?       @db.VarChar(500)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  addons       Addon[]
  drinks       Drink[]
  orderItems   OrderItem[]
  sizes        ProductSize[]
  category     Category      @relation(fields: [categoryId], references: [id])
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id])
  cartItems    CartItem[]  

  @@index([categoryId], map: "products_categoryId_fkey")
  @@index([restaurantId], map: "products_restaurantId_fkey")
  @@map("products")
}

model ProductSize {
  id         Int         @id @default(autoincrement())
  productId  Int
  name       String      @db.VarChar(50)
  extraPrice Decimal     @default(0.00) @db.Decimal(10, 2)
  isActive   Boolean     @default(true)
  orderItems OrderItem[]
  product    Product     @relation(fields: [productId], references: [id])

  @@index([productId], map: "product_sizes_productId_fkey")
  @@map("product_sizes")
}

model Addon {
  id              Int              @id @default(autoincrement())
  productId       Int
  name            String           @db.VarChar(100)
  price           Decimal          @default(0.00) @db.Decimal(10, 2)
  isActive        Boolean          @default(true)
  product         Product          @relation(fields: [productId], references: [id])
  orderItemAddons OrderItemAddon[]

  @@index([productId], map: "addons_productId_fkey")
  @@map("addons")
}

model Drink {
  id         Int         @id @default(autoincrement())
  productId  Int
  name       String      @db.VarChar(100)
  price      Decimal     @default(0.00) @db.Decimal(10, 2)
  isActive   Boolean     @default(true)
  product    Product     @relation(fields: [productId], references: [id])
  orderItems OrderItem[]

  @@index([productId], map: "drinks_productId_fkey")
  @@map("drinks")
}

model Offer {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(120)
  description String?  @db.Text
  discount    Decimal  @db.Decimal(5, 2)
  code        String?  @unique @db.VarChar(30)
  imageUrl    String?  @db.VarChar(500)
  startsAt    DateTime
  endsAt      DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  orders      Order[]

  @@map("offers")
}

model Address {
  id        Int     @id @default(autoincrement())
  userId    Int
  alias     String  @db.VarChar(60)
  street    String  @db.VarChar(255)
  city      String  @db.VarChar(100)
  latitude  Decimal @db.Decimal(10, 8)
  longitude Decimal @db.Decimal(11, 8)
  isDefault Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id])
  orders    Order[]

  @@index([userId], map: "addresses_userId_fkey")
  @@map("addresses")
}

model PaymentMethod_ {
  id        Int     @id @default(autoincrement())
  userId    Int
  alias     String  @db.VarChar(60)
  lastFour  String  @db.VarChar(4)
  brand     String  @db.VarChar(30)
  isDefault Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id])

  @@index([userId], map: "payment_methods_userId_fkey")
  @@map("payment_methods")
}

model CartItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  sizeId    Int?
  drinkId   Int?
  quantity  Int      @default(1)
  unitPrice Decimal  @db.Decimal(10, 2)
  notes     String?  @db.VarChar(255)
  addonIds  String?  @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([userId])
  @@map("cart_items")
}

model Order {
  id            Int           @id @default(autoincrement())
  userId        Int
  restaurantId  Int
  addressId     Int?
  offerId       Int?
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod
  subtotal      Decimal       @db.Decimal(10, 2)
  discount      Decimal       @default(0.00) @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  notes         String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         OrderItem[]
  address       Address?      @relation(fields: [addressId], references: [id])
  offer         Offer?        @relation(fields: [offerId], references: [id])
  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id])
  user          User          @relation(fields: [userId], references: [id])

  @@index([addressId], map: "orders_addressId_fkey")
  @@index([offerId], map: "orders_offerId_fkey")
  @@index([restaurantId], map: "orders_restaurantId_fkey")
  @@index([userId], map: "orders_userId_fkey")
  @@map("orders")
}

model OrderItem {
  id         Int              @id @default(autoincrement())
  orderId    Int
  productId  Int
  sizeId     Int?
  drinkId    Int?
  quantity   Int              @default(1)
  unitPrice  Decimal          @db.Decimal(10, 2)
  totalPrice Decimal          @db.Decimal(10, 2)
  notes      String?          @db.VarChar(255)
  addons     OrderItemAddon[]
  drink      Drink?           @relation(fields: [drinkId], references: [id])
  order      Order            @relation(fields: [orderId], references: [id])
  product    Product          @relation(fields: [productId], references: [id])
  size       ProductSize?     @relation(fields: [sizeId], references: [id])

  @@index([drinkId], map: "order_items_drinkId_fkey")
  @@index([orderId], map: "order_items_orderId_fkey")
  @@index([productId], map: "order_items_productId_fkey")
  @@index([sizeId], map: "order_items_sizeId_fkey")
  @@map("order_items")
}

model OrderItemAddon {
  id          Int       @id @default(autoincrement())
  orderItemId Int
  addonId     Int
  price       Decimal   @db.Decimal(10, 2)
  addon       Addon     @relation(fields: [addonId], references: [id])
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  @@index([addonId], map: "order_item_addons_addonId_fkey")
  @@index([orderItemId], map: "order_item_addons_orderItemId_fkey")
  @@map("order_item_addons")
}

enum Role {
  ADMIN
  MANAGER
  CLIENT
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CARD
  CASH
}

enum DayPart {
  BREAKFAST
  LUNCH
  DINNER
}